# secret-board deploy env. Copy to .env next to docker-compose.yml and fill in.

SECRET_BOARD_VERSION=0.1.0
# e.g. ghcr.io/<owner>/secret-board (default: locally built `secret-board`)
IMAGE_REPO=
TIMEZONE=Asia/Seoul

# Public URL users open (scheme + host [+ port]). Google redirect URI is
# ${PORTAL_ORIGIN}/api/auth/callback/google
PORTAL_ORIGIN=https://secret-board.example.com
PORTAL_PORT=3000

# 32+ random chars each: openssl rand -base64 32
BETTER_AUTH_SECRET=
SECRET_BOARD_BACKEND_SECRET=

# Google OAuth client (consent screen user type: Internal)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_DOMAIN=corelinesoft.com
