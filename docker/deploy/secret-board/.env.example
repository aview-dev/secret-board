# secret-board deploy env. Copy to .env next to docker-compose.yml and fill in.

SECRET_BOARD_VERSION=0.1.0
# Image name prefix. Leave as is when building locally with --build;
# set e.g. ghcr.io/<owner>/secret-board to pull prebuilt images instead.
IMAGE_REPO=secret-board
TIMEZONE=Asia/Seoul

# Host name users open, without scheme or port.
# Users browse to https://${SITE_ADDRESS}:${HTTPS_PORT}.
# No company domain yet: use sslip.io, which resolves "<ip with dashes>.sslip.io"
# to that IP (e.g. 10-77-4-34.sslip.io -> 10.77.4.34).
# Google OAuth client must list (port included):
#   JavaScript origin  https://${SITE_ADDRESS}:${HTTPS_PORT}
#   redirect URI       https://${SITE_ADDRESS}:${HTTPS_PORT}/api/auth/callback/google
SITE_ADDRESS=10-77-4-34.sslip.io
# Host ports. 80 / 443 stay free for other projects on the same machine.
# HTTP_PORT only redirects to HTTPS_PORT.
HTTP_PORT=8088
HTTPS_PORT=8443

# 32+ random chars each: openssl rand -base64 32
BETTER_AUTH_SECRET=
SECRET_BOARD_BACKEND_SECRET=

# Google OAuth client (consent screen audience: Internal)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_DOMAIN=corelinesoft.com
