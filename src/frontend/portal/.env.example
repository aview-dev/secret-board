# Portal dev env. Copy to .env in this directory (vite reads it).

# 32자 이상 랜덤 문자열. 생성: openssl rand -base64 32
BETTER_AUTH_SECRET=
# 브라우저에서 보이는 주소 (개발: http://localhost:5173)
BETTER_AUTH_URL=http://localhost:5173

# Google OAuth 클라이언트 - docs/google-oauth.md
# 승인된 리디렉션 URI: http://localhost:5173/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 로그인을 허용할 Google Workspace 도메인
ALLOWED_DOMAIN=corelinesoft.com
AUTH_DB_PATH=auth.db

# 항상 관리자인 계정 (쉼표로 구분, 강등 불가). 다른 관리자는 /admin/users 에서 지정
ADMIN_EMAILS=

# Go backend (make backend). SECRET 이 비어 있으면 backend 가 검사를 건너뛴다 (개발용).
SECRET_BOARD_BACKEND_URL=http://localhost:8080
SECRET_BOARD_BACKEND_SECRET=
